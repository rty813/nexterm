{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexterm",
  "version": "0.1.5",
  "identifier": "com.nexterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexterm",
        "width": 1360,
        "height": 840,
        "minWidth": 860,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/vcxsrv/": "vcxsrv/",
      "resources/commands/": "commands/"
    }
  }
}
