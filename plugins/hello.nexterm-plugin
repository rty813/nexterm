{"manifest":{"apiVersion":1,"id":"example.hello","name":"Hello Nexterm","version":"0.1.0","main":"main.js","permissions":{"network":[]},"contributes":{"commands":[{"id":"show","title":"Hello Nexterm"}],"views":[{"id":"hello","title":"Hello Nexterm","location":"tab","file":"view.html"}],"statusBar":[{"id":"hello-status","text":"Hello","command":"show"}]}},"files":{"main.js":"let count = 0;\nnexterm.onCommand(\"show\", () => nexterm.views.open(\"hello\"));\nnexterm.handle(\"increment\", async () => {\n  count++;\n  await nexterm.status.update(\"hello-status\", `Hello ${count}`);\n  await nexterm.publish(\"count\", count);\n  return count;\n});\n","view.html":"<html lang=\"en\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Hello Nexterm</title>\n<style>:root{color-scheme:dark;font:13px system-ui;background:#242424;color:#ddd}body{margin:20px}h1{font-size:18px}button{font:inherit;padding:6px 12px;color:inherit;background:#333;border:1px solid #666;border-radius:4px}</style>\n<h1>Hello Nexterm</h1><button id=\"count\" type=\"button\">0</button>\n<script>\nconst button = document.getElementById(\"count\");\nnexterm.on(\"count\", count => {button.textContent = String(count);});\nbutton.onclick = async () => {button.textContent = String(await nexterm.request(\"increment\"));};\n</script></html>\n"}}
